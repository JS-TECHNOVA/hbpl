# Copy to /var/www/hbpl/.env on the server and replace every placeholder.
# Keep this file private. Do not commit the real .env.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
DEBUG=False
ALLOWED_HOSTS=myhbpl.org,www.myhbpl.org

# PostgreSQL
DATABASE_URL=postgres://hbpl_user:replace-with-db-password@127.0.0.1:5432/hbpl_db
DB_SSL=False
DB_CONN_MAX_AGE=0

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://myhbpl.org,https://www.myhbpl.org
CSRF_TRUSTED_ORIGINS=https://myhbpl.org,https://www.myhbpl.org

# HTTPS / security
HTTPS_ENABLED=True
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=False
HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-email
EMAIL_HOST_PASSWORD=replace-with-new-gmail-app-password
DEFAULT_FROM_EMAIL=HBPL <replace-with-smtp-email>

# Payments
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-new-razorpay-secret
TEAM_REGISTRATION_FEE_PAISE=100
CASHFREE_APP_ID=replace-with-cashfree-app-id
CASHFREE_SECRET_KEY=replace-with-new-cashfree-secret
CASHFREE_ENV=sandbox
EXAM_PORTAL_URL=https://myhbpl.org

# ── Next.js ──────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXTAUTH_URL=https://myhbpl.org
NEXTAUTH_SECRET=replace-with-a-new-nextauth-secret
AUTH_SECRET=replace-with-a-new-auth-secret

# The browser must use the public HTTPS origin. Nginx proxies /api and /ws.
NEXT_PUBLIC_API_URL=https://myhbpl.org
NEXT_PUBLIC_WS_URL=wss://myhbpl.org
NEXT_PUBLIC_SOCKET_URL=wss://myhbpl.org
SOCKET_PORT=3001

# Optional Next.js / storage settings, if used by the application.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-long-random-key
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
